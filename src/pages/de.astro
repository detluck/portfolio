---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Panel from '../components/ui/Panel.astro';
import Button from '../components/ui/Button.astro';
import meImage from '../assets/me.jpg';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Pavlo Sytnyk — Portfolio" lang="de">
  <div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch">
      <div class="md:col-span-4 flex flex-col gap-4">
        <Panel title="imv me.jpg" bodyClass="p-0">
          <div class="overflow-hidden aspect-square w-full">
            <Image
              src={meImage}
              alt="Pavlo Sytnyk"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </Panel>

        <Panel title="systemctl status" bodyClass="p-4" class="flex-1 flex flex-col justify-center">
          <div class="space-y-2.5 font-mono text-xs">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-ctp-green opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-ctp-green"></span>
              </span>
              <span class="text-ctp-green font-semibold">verfügbar für Arbeit</span>
            </div>

            <div class="text-[11px] text-ctp-subtext0 space-y-1 pt-2 border-t border-ctp-surface0/60">
              <div class="flex items-center justify-between">
                <span class="text-ctp-subtext1">Standort:</span>
                <span class="text-ctp-text">Hamburg, DE</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-ctp-subtext1">Suche:</span>
                <span class="text-ctp-yellow">Praktikum / Werkstudent</span>
              </div>
            </div>
          </div>
        </Panel>
      </div>

      <Panel title="whoami" class="md:col-span-8 flex flex-col" bodyClass="p-5 sm:p-6 flex-1 flex flex-col justify-between">
        <div class="space-y-4 font-mono flex-1 flex flex-col">
          <div>
            <div class="text-xs text-ctp-subtext0 flex items-center gap-1.5">
              <span class="text-ctp-green font-semibold">detluck@workstation</span>
              <span class="text-ctp-surface2">:</span>
              <span class="text-ctp-blue font-semibold">~</span>
              <span class="text-ctp-subtext1">$ whoami</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ctp-text font-sans mt-2">
              Pavlo Sytnyk
            </h1>
            <p class="text-xs text-ctp-peach tracking-wide mt-1">
              Informatik @ HAW Hamburg
            </p>
          </div>

          <div class="pt-3 border-t border-ctp-surface0/60 text-xs">
            <span class="text-ctp-subtext1 block mb-2 font-semibold tracking-wider uppercase">
              Nützliche Links:
            </span>
            <ul class="space-y-1.5">
              <li>
                <a
                  href="https://github.com/detluck"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-ctp-blue hover:text-ctp-lavender hover:underline transition-colors"
                >
                  <span class="text-ctp-surface2">&gt;</span>
                  <span>github.com/detluck</span>
                </a>
              </li>
              <li>
                <a
                  href="https://www.linkedin.com/in/pavlo-sytnyk-785512434"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-ctp-blue hover:text-ctp-lavender hover:underline transition-colors"
                >
                  <span class="text-ctp-surface2">&gt;</span>
                  <span>linkedin.com/in/pavlo-sytnyk</span>
                </a>
              </li>
              <li>
                <a
                  href="mailto:pavlosytnyk@protonmail.com"
                  class="inline-flex items-center gap-2 text-ctp-blue hover:text-ctp-lavender hover:underline transition-colors"
                >
                  <span class="text-ctp-surface2">&gt;</span>
                  <span>pavlosytnyk@protonmail.com</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="pt-3 border-t border-ctp-surface0/60 text-xs">
            <span class="text-ctp-subtext1 block mb-2 font-semibold tracking-wider uppercase">
              Haupt-Stack:
            </span>
            <div class="flex flex-wrap gap-1.5">
              {['Java', 'C++', 'C', 'Linux', 'Spring Boot', 'PostgreSQL', 'TypeScript', 'Astro'].map((tech) => (
                <span class="px-2 py-0.5 rounded-md bg-ctp-surface0/70 text-ctp-text border border-ctp-surface1/40 text-[11px]">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-ctp-surface0/60 flex-1 flex flex-wrap items-center justify-center gap-4">
            <Button variant="primary" size="md" href={`${base}project`}>
              Meine Projekte
            </Button>
            <Button variant="primary" size="md" href={`${base}github`}>
              Meine GitHub-Stats
            </Button>
          </div>
        </div>
      </Panel>
    </div>

    <Panel title='getent passwd "$USER"' bodyClass="p-5 sm:p-6">
      <div class="space-y-4">
        <div class="text-xs bg-ctp-crust/70 p-3 rounded-xl border border-ctp-surface0/60 text-ctp-subtext0 font-mono overflow-x-auto shadow-inner">
          <span class="text-ctp-peach">detluck</span>:x:1000:1000:<span class="text-ctp-yellow">Pavlo Sytnyk (Informatik B.Sc.)</span>:<span class="text-ctp-blue">/home/detluck</span>:<span class="text-ctp-green">/usr/bin/zsh</span>
        </div>

        <p class="text-sm text-ctp-subtext0 leading-relaxed font-sans">
          Ich bin Informatikstudent an der <strong class="text-ctp-text font-semibold">Hochschule für Angewandte Wissenschaften Hamburg</strong> (HAW Hamburg). Leidenschaftlich daran interessiert, Software von Grund auf zu entwickeln, Backend-Systeme (besonders mit Java), Linux-Betriebssysteme und systemnahe Programmierung mit C und C++.
        </p>

        <div class="pt-2">
          <Button variant="primary" size="sm" href={`${base}about`}>
            Mehr über mich &rarr;
          </Button>
        </div>
      </div>
    </Panel>
  </div>
</Layout>
